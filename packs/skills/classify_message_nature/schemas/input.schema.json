{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "classify_message_nature input",
  "type": "object",
  "required": [
    "body_text",
    "source_channel",
    "from_identifier"
  ],
  "additionalProperties": false,
  "properties": {
    "body_text": {
      "type": "string",
      "description": "The message body. May be empty after trimming, but the field is required."
    },
    "source_channel": {
      "type": "string",
      "description": "The channel the message arrived on (e.g. gmail, imessage_adminme, sms_twilio)."
    },
    "from_identifier": {
      "type": "string",
      "description": "Sender's address \u2014 email, phone number, or handle."
    },
    "counterparty_identifier": {
      "type": "string",
      "description": "The other participant address used for direction-aware extraction."
    },
    "message_direction": {
      "type": "string",
      "enum": [
        "inbound",
        "outbound"
      ],
      "description": "Derived from the immutable event type or provider SENT label."
    },
    "subject": {
      "type": "string",
      "description": "Email subject. Absent for SMS / iMessage."
    },
    "from_party_known": {
      "type": "boolean",
      "description": "Has a Party already been resolved for this sender? Hint only \u2014 defaults to false in the noise_filtering pipeline."
    },
    "candidate_mode": {
      "type": "string",
      "enum": [
        "review",
        "manual",
        "quiet"
      ],
      "description": "Member candidate-admission policy. Classification still runs; only review admits candidates."
    },
    "candidate_language_enabled": {
      "type": "boolean",
      "description": "Whether grounded language output may contribute candidate fields."
    },
    "candidate_kinds": {
      "type": "array",
      "maxItems": 11,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "task",
          "commitment",
          "calendar_event",
          "reminder",
          "list",
          "list_item",
          "recurrence",
          "party_identifier",
          "party_candidate",
          "party_relationship",
          "relationship_fact"
        ]
      }
    },
    "candidate_scope": {
      "type": "string",
      "enum": [
        "primary_thread",
        "deferred_to_latest_thread_message"
      ],
      "description": "Only the latest message in a provider thread may emit the thread's candidate set."
    },
    "context_pack": {
      "type": "object",
      "required": [
        "contract",
        "thread_key",
        "context_fingerprint",
        "current_source_id",
        "messages"
      ],
      "additionalProperties": false,
      "properties": {
        "contract": {
          "const": "message-context-pack-v2"
        },
        "thread_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "context_fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "current_source_id": {
          "type": "string",
          "pattern": "^m[0-9]{2}$"
        },
        "messages": {
          "type": "array",
          "minItems": 1,
          "maxItems": 18,
          "items": {
            "type": "object",
            "required": [
              "source_id",
              "relation",
              "relation_reason_codes",
              "direction",
              "occurred_at",
              "source_channel",
              "sender",
              "recipients",
              "subject",
              "body_text",
              "attachment_names"
            ],
            "additionalProperties": false,
            "properties": {
              "source_id": {
                "type": "string",
                "pattern": "^m[0-9]{2}$"
              },
              "relation": {
                "type": "string",
                "enum": [
                  "thread",
                  "related"
                ]
              },
              "relation_reason_codes": {
                "type": "array",
                "minItems": 1,
                "maxItems": 8,
                "items": {
                  "type": "string",
                  "enum": [
                    "provider_thread_id",
                    "rfc_reference",
                    "attachment_identity",
                    "member_confirmed_context",
                    "participant_overlap",
                    "participant_reference_overlap",
                    "subject_token_overlap",
                    "attachment_filename_overlap"
                  ]
                }
              },
              "direction": {
                "type": "string",
                "enum": [
                  "inbound",
                  "outbound"
                ]
              },
              "occurred_at": {
                "type": "string",
                "maxLength": 100
              },
              "source_channel": {
                "type": "string",
                "maxLength": 100
              },
              "sender": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 1000
              },
              "recipients": {
                "type": "array",
                "maxItems": 30,
                "items": {
                  "type": "string",
                  "maxLength": 1000
                }
              },
              "subject": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 1000
              },
              "body_text": {
                "type": "string",
                "maxLength": 12000
              },
              "attachment_names": {
                "type": "array",
                "maxItems": 20,
                "items": {
                  "type": "string",
                  "maxLength": 240
                }
              },
              "text_truncated": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "assessment_contract": {
      "const": "personal-obligation-assessment-v1"
    }
  }
}
