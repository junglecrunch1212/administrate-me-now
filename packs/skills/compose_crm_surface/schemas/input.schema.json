{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "compose_crm_surface input",
  "type": "object",
  "required": [
    "member_id",
    "week_of_date",
    "profile_format",
    "surfaced_parties"
  ],
  "additionalProperties": false,
  "properties": {
    "member_id": {
      "type": "string",
      "minLength": 1,
      "description": "Household member whose CRM surface this is."
    },
    "week_of_date": {
      "type": "string",
      "minLength": 1,
      "description": "ISO date string identifying the week-of anchor (member-local YYYY-MM-DD)."
    },
    "profile_format": {
      "type": "string",
      "enum": ["fog_aware", "compressed", "carousel", "child", "none"],
      "description": "Shapes tone + density of the rendered body."
    },
    "surfaced_parties": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["party_id", "gap_kind"],
        "properties": {
          "party_id": { "type": "string", "minLength": 1 },
          "party_name": { "type": ["string", "null"] },
          "gap_kind": {
            "type": "string",
            "enum": ["stale_contact", "upcoming_birthday", "hosting_imbalance"]
          },
          "last_interaction_at": { "type": ["string", "null"] },
          "next_birthday": { "type": ["string", "null"] },
          "host_guest_balance": { "type": ["number", "null"] },
          "notes": { "type": ["string", "null"] }
        },
        "additionalProperties": true
      }
    }
  }
}
