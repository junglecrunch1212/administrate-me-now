{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "extract_note_semantics input",
  "type": "object",
  "required": ["body_text", "body_format", "source_kind"],
  "additionalProperties": false,
  "properties": {
    "title": {"type": ["string", "null"], "maxLength": 1000},
    "body_text": {"type": "string", "minLength": 1, "maxLength": 50000},
    "body_format": {"type": "string", "enum": ["plain", "html", "markdown", "transcript"]},
    "source_kind": {"type": "string", "minLength": 1, "maxLength": 100},
    "content_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"}
  }
}
