{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "extract_note_semantics output",
  "type": "object",
  "required": ["candidates", "reasons"],
  "additionalProperties": false,
  "properties": {
    "candidates": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": ["target_kind", "title", "candidate", "evidence_quote", "confidence", "reasons"],
        "additionalProperties": false,
        "properties": {
          "target_kind": {"type": "string", "enum": ["task", "commitment", "calendar_event", "reminder", "list", "list_item", "recurrence", "party_identifier", "party_candidate", "party_relationship", "relationship_fact"]},
          "title": {"type": "string", "minLength": 1, "maxLength": 1000},
          "candidate": {"type": "object"},
          "evidence_quote": {"type": "string", "minLength": 1, "maxLength": 2000},
          "confidence": {"type": "number", "minimum": 0.0, "maximum": 1.0},
          "reasons": {"type": "array", "maxItems": 20, "items": {"type": "string", "maxLength": 500}}
        }
      }
    },
    "reasons": {"type": "array", "maxItems": 20, "items": {"type": "string", "maxLength": 500}}
  }
}
