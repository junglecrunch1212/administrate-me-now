{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "compose_custody_brief input",
  "type": "object",
  "required": [
    "member_profile",
    "coparent_profile",
    "child_profiles",
    "calendar_events",
    "handoff_timing",
    "allergen_med_notes"
  ],
  "additionalProperties": false,
  "properties": {
    "member_profile": {
      "type": "object",
      "required": ["member_id"],
      "properties": {
        "member_id": { "type": "string", "minLength": 1 },
        "tone": {
          "type": ["string", "null"],
          "description": "Per F-8 carry-forward from 10c-ii: shapes voice of the composed brief."
        }
      },
      "additionalProperties": true
    },
    "coparent_profile": {
      "type": "object",
      "required": ["member_id"],
      "properties": {
        "member_id": { "type": "string", "minLength": 1 },
        "display_name": { "type": ["string", "null"] }
      },
      "additionalProperties": true
    },
    "child_profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["member_id"],
        "properties": {
          "member_id": { "type": "string", "minLength": 1 },
          "display_name": { "type": ["string", "null"] },
          "age": { "type": ["integer", "null"], "minimum": 0 }
        },
        "additionalProperties": true
      }
    },
    "calendar_events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "title": { "type": "string" },
          "child_member_id": { "type": ["string", "null"] },
          "start_at": { "type": ["string", "null"] },
          "end_at": { "type": ["string", "null"] }
        },
        "additionalProperties": true
      },
      "description": "Next-day calendar events for the children. May be empty for a low-event day; brief still composes on handoff_timing + allergen_med_notes alone."
    },
    "handoff_timing": {
      "type": "object",
      "description": "Member-profile-derived custody-handoff pattern (which parent has the children when on the next day).",
      "additionalProperties": true
    },
    "allergen_med_notes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["child_member_id", "note"],
        "properties": {
          "child_member_id": { "type": "string", "minLength": 1 },
          "note": { "type": "string" }
        },
        "additionalProperties": true
      }
    }
  }
}
