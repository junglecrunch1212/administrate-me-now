{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "compose_custody_brief input",
  "type": "object",
  "required": [
    "member_id",
    "coparent_member_id",
    "child_member_ids",
    "brief_date",
    "profile_format"
  ],
  "additionalProperties": false,
  "properties": {
    "member_id": {
      "type": "string",
      "minLength": 1,
      "description": "Member id this brief is composed for (the parent receiving the brief)."
    },
    "coparent_member_id": {
      "type": "string",
      "minLength": 1,
      "description": "Coparent member id (the other parent in the handoff)."
    },
    "child_member_ids": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "description": "Child member ids covered by this brief."
    },
    "brief_date": {
      "type": "string",
      "minLength": 1,
      "description": "ISO date string for the day this brief covers (member-local YYYY-MM-DD)."
    },
    "profile_format": {
      "type": "string",
      "enum": ["fog_aware", "compressed", "carousel", "child", "none"],
      "description": "Shapes tone + density of the rendered body."
    },
    "next_day_events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "title": { "type": "string" },
          "child_member_id": { "type": ["string", "null"] },
          "start_at": { "type": ["string", "null"] },
          "end_at": { "type": ["string", "null"] }
        },
        "additionalProperties": true
      }
    },
    "handoff_timing": {
      "type": ["object", "null"],
      "additionalProperties": true,
      "properties": {
        "pickup_at": { "type": ["string", "null"] },
        "dropoff_at": { "type": ["string", "null"] },
        "location": { "type": ["string", "null"] }
      }
    },
    "allergen_notes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["child_member_id", "note"],
        "properties": {
          "child_member_id": { "type": "string", "minLength": 1 },
          "note": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": true
      }
    },
    "medication_notes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["child_member_id", "note"],
        "properties": {
          "child_member_id": { "type": "string", "minLength": 1 },
          "note": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": true
      }
    }
  }
}
