{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "compose_custody_brief input",
  "type": "object",
  "required": [
    "member_profile",
    "coparent_profile",
    "child_profiles",
    "calendar_events",
    "handoff_timing",
    "allergen_med_notes"
  ],
  "additionalProperties": false,
  "properties": {
    "member_profile": {
      "type": "object",
      "required": ["member_id"],
      "properties": {
        "member_id": { "type": "string", "minLength": 1 },
        "tone": { "type": ["string", "null"] },
        "preferred_channel": { "type": ["string", "null"] }
      },
      "additionalProperties": true
    },
    "coparent_profile": {
      "type": "object",
      "required": ["member_id"],
      "properties": {
        "member_id": { "type": "string", "minLength": 1 },
        "display_name": { "type": ["string", "null"] }
      },
      "additionalProperties": true
    },
    "child_profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["member_id"],
        "properties": {
          "member_id": { "type": "string", "minLength": 1 },
          "display_name": { "type": ["string", "null"] },
          "age": { "type": ["integer", "null"] }
        },
        "additionalProperties": true
      }
    },
    "calendar_events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "title": { "type": "string" },
          "start_at": { "type": ["string", "null"] },
          "end_at": { "type": ["string", "null"] },
          "for_child_member_id": { "type": ["string", "null"] }
        },
        "additionalProperties": true
      }
    },
    "handoff_timing": {
      "type": "object",
      "properties": {
        "pickup_at": { "type": ["string", "null"] },
        "dropoff_at": { "type": ["string", "null"] },
        "location": { "type": ["string", "null"] },
        "notes": { "type": ["string", "null"] }
      },
      "additionalProperties": true
    },
    "allergen_med_notes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["note"],
        "properties": {
          "note": { "type": "string" },
          "child_member_id": { "type": ["string", "null"] },
          "category": { "type": ["string", "null"] }
        },
        "additionalProperties": true
      }
    }
  }
}
