{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "match",
    "evidence"
  ],
  "properties": {
    "match": {
      "enum": [
        "matched",
        "not_requested",
        "ambiguous",
        "unavailable"
      ]
    },
    "evidence": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text"
        ],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32000
          }
        }
      }
    }
  }
}
