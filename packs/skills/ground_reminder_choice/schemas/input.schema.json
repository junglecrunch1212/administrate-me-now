{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "original_instruction",
    "answer",
    "original_submitted_at",
    "answer_submitted_at",
    "timezone",
    "action",
    "offered_choices"
  ],
  "properties": {
    "original_instruction": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32000
    },
    "answer": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32000
    },
    "original_submitted_at": {
      "type": "string",
      "minLength": 1
    },
    "answer_submitted_at": {
      "type": "string",
      "minLength": 1
    },
    "timezone": {
      "type": "string",
      "minLength": 1
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "operation",
        "resource_owner",
        "title",
        "due_at",
        "list_id",
        "selected_by_policy"
      ],
      "properties": {
        "provider": {
          "const": "apple_reminders"
        },
        "operation": {
          "const": "create_reminder"
        },
        "resource_owner": {
          "const": "requester"
        },
        "title": {
          "type": "string"
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        },
        "due_at": {
          "type": "string"
        },
        "list_id": {
          "type": "string"
        },
        "selected_by_policy": {
          "type": "boolean"
        }
      }
    },
    "offered_choices": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "list_id",
          "label"
        ],
        "properties": {
          "list_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        }
      }
    }
  }
}
