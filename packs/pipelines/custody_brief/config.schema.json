{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "custody_brief pipeline config",
  "type": "object",
  "additionalProperties": false,
  "required": ["brief_local_hour"],
  "properties": {
    "brief_local_hour": {
      "type": "integer",
      "minimum": 0,
      "maximum": 23,
      "description": "Local hour the brief fires; cron sidecar is the actual schedule wire-up."
    },
    "per_member_overrides": {
      "type": "object",
      "description": "Map of member_id → per-member overrides. custody_brief_enabled defaults to TRUE (opt-out).",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "custody_brief_enabled": { "type": "boolean" },
          "lookahead_days": { "type": "integer", "minimum": 1 }
        }
      }
    }
  }
}
