{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "crm_surface pipeline config",
  "type": "object",
  "additionalProperties": false,
  "required": ["threshold_days", "max_surfaced_per_week"],
  "properties": {
    "threshold_days": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3650
    },
    "max_surfaced_per_week": {
      "type": "integer",
      "minimum": 1,
      "maximum": 50
    },
    "cadence_day_of_week": {
      "type": "integer",
      "minimum": 0,
      "maximum": 6
    },
    "cadence_local_hour": {
      "type": "integer",
      "minimum": 0,
      "maximum": 23
    },
    "per_member_overrides": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "crm_proactive_enabled": {"type": "boolean"},
          "threshold_days": {"type": "integer", "minimum": 1, "maximum": 3650}
        }
      }
    }
  }
}
