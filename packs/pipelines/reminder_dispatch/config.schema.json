{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "reminder_dispatch pipeline config",
  "type": "object",
  "additionalProperties": false,
  "required": ["lookahead_window_minutes", "min_reminder_gap_minutes", "dedupe_window_minutes"],
  "properties": {
    "lookahead_window_minutes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1440
    },
    "min_reminder_gap_minutes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1440
    },
    "dedupe_window_minutes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10080
    },
    "skip_party_tags": {
      "type": "array",
      "items": {"type": "string"}
    },
    "per_member_overrides": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "reminders_enabled": {"type": "boolean"},
          "lookahead_window_minutes": {"type": "integer", "minimum": 1, "maximum": 1440},
          "dedupe_window_minutes": {"type": "integer", "minimum": 1, "maximum": 10080}
        }
      }
    }
  }
}
