{
  "$schema": "https://code.claude.com/schemas/claude-settings.json",

  "_comment": "Claude Code settings for AdministrateMe Executor sessions in JRS Codespace. Permissions allow the build operations (git, gh, pytest, poetry, etc.); hooks enforce invariants and gating; model defaults to Opus 4.7.",

  "permissions": {
    "allow": [
      "Read",
      "Write",
      "Edit",
      "MultiEdit",
      "Glob",
      "Grep",
      "Bash(git *)",
      "Bash(gh *)",
      "Bash(pytest *)",
      "Bash(python3 *)",
      "Bash(poetry *)",
      "Bash(npm *)",
      "Bash(node *)",
      "Bash(cat *)",
      "Bash(ls *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(sed *)",
      "Bash(awk *)",
      "Bash(find *)",
      "Bash(mkdir *)",
      "Bash(touch *)",
      "Bash(rm *)",
      "Bash(mv *)",
      "Bash(cp *)",
      "Bash(jq *)",
      "Bash(bash scripts/*)",
      "Bash(./scripts/*)",
      "Bash(./bootstrap/*)"
    ],
    "deny": [
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~/*)",
      "Bash(rm -rf ${HOME}/*)",
      "Bash(sudo *)",
      "Bash(curl http*)",
      "Bash(curl https*)",
      "Bash(wget *)",
      "Bash(npm install -g*)",
      "Bash(pip install -U pip*)",
      "Bash(brew *)",
      "Bash(apt*)"
    ]
  },

  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/post-edit-verify.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/pre-bash-spend-check.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/stop-checkpoint-pause.sh"
          }
        ]
      }
    ]
  },

  "env": {
    "ADMINME_DAILY_SPEND_CAP_USD_DEFAULT": "50",
    "ADMINME_PROJECT_ROOT": "${CLAUDE_PROJECT_DIR}",
    "ADMINME_BUILD_PHASE": "A",
    "ADMINME_OBSERVATION_MODE": "0"
  },

  "model": {
    "default": "opus"
  }
}
