"""Cat-B central external-state-mirror adapter scaffold for ``<NAME>``.

Generated by ``adminme adapters scaffold Cat-B central``. Cat-B adapters
bidirectionally mirror an external system (Google Calendar, CalDAV,
Apple Reminders, etc.). Asymmetric writes per [UT-27]: the manifest
declares each per-operation capability and :meth:`_apply_write_impl`
dispatches on ``operation.kind``.

The :meth:`_apply_write_impl` body routes through
:func:`adminme.lib.observation.outbound` per [§6.20]; observation mode
suppresses the write when active.
"""

from __future__ import annotations

from adminme.adapters.base import AdapterContext, AdapterStatus
from adminme.lib.adapters import (
    ChangeEnvelope,
    ExternalStateMirrorAdapter,
    WriteOperation,
    WriteResult,
)
from adminme.lib.observation import outbound


class <CLASSNAME>(ExternalStateMirrorAdapter):
    """Cat-B calendaring external-state-mirror scaffold for ``<NAME>``."""

    name = "<NAME>"
    family = "calendaring"
    version = "0.1.0"
    write_capabilities = ["create_event", "delete_event"]
    sharing_model_discriminator = "owner_member_id"

    def __init__(self) -> None:
        self._status = AdapterStatus()

    async def start(self, *, ctx: AdapterContext) -> None:
        self._status.state = "running"

    async def stop(self) -> None:
        self._status.state = "stopped"

    def status(self) -> AdapterStatus:
        return self._status

    async def _apply_write_impl(self, operation: WriteOperation) -> WriteResult:
        async def _do_write() -> WriteResult:
            if operation.kind == "create_event":
                return WriteResult(applied=True, external_id=None)
            if operation.kind == "delete_event":
                return WriteResult(applied=True, external_id=None)
            return WriteResult(applied=False)

        result = await outbound(
            session=None,  # type: ignore[arg-type]
            action=operation.kind,
            payload=dict(operation.payload),
            action_fn=_do_write,
            manager=None,  # type: ignore[arg-type]
            event_log=None,  # type: ignore[arg-type]
        )
        if result.suppressed:
            return WriteResult(applied=False, suppressed=True)
        return result.result  # type: ignore[no-any-return]

    async def _on_external_change(self, envelope: ChangeEnvelope) -> None:
        return None
