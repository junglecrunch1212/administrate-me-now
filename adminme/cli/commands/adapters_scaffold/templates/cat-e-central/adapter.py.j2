"""Cat-E central outbound-action adapter scaffold for ``<NAME>``.

Generated by ``adminme adapters scaffold Cat-E central``. Cat-E adapters
consume ``action.requested`` events and execute external side effects
(home automation scenes, SMS dispatches, webhook fires). The contract
pins ``observation_mode_required=True`` and the :meth:`execute_action`
body MUST route through :func:`adminme.lib.observation.outbound` so
observation mode suppresses the side effect per [§6.20].
"""

from __future__ import annotations

from adminme.adapters.base import AdapterContext, AdapterStatus
from adminme.lib.adapters import (
    ActionRequest,
    ActionResult,
    OutboundActionAdapter,
)
from adminme.lib.observation import outbound


class <CLASSNAME>(OutboundActionAdapter):
    """Cat-E external-action scaffold for ``<NAME>``."""

    name = "<NAME>"
    family = "external_action"
    version = "0.1.0"

    def __init__(self) -> None:
        self._status = AdapterStatus()

    async def start(self, *, ctx: AdapterContext) -> None:
        self._status.state = "running"

    async def stop(self) -> None:
        self._status.state = "stopped"

    def status(self) -> AdapterStatus:
        return self._status

    async def execute_action(self, request: ActionRequest) -> ActionResult:
        async def _do_execute() -> ActionResult:
            return ActionResult(executed=True, external_id=None)

        result = await outbound(
            session=None,  # type: ignore[arg-type]
            action=request.kind,
            payload=dict(request.payload),
            action_fn=_do_execute,
            manager=None,  # type: ignore[arg-type]
            event_log=None,  # type: ignore[arg-type]
            target_identifier=request.target_external_id or "unknown",
        )
        if result.suppressed:
            return ActionResult(executed=False, suppressed=True)
        return result.result  # type: ignore[no-any-return]
