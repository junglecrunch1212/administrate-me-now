{
  "id": "administrateme",
  "name": "AdministrateMe",
  "description": "Authorized household state and action seam for AdministrateMe v2.",
  "version": "2.0.0-gate8",
  "activation": {
    "onStartup": true,
    "onCommands": [
      "adminme-now",
      "adminme-triage",
      "adminme-inbox",
      "adminme-done",
      "adminme-defer",
      "adminme-snooze",
      "adminme-block",
      "adminme-unblock",
      "adminme-forward"
    ]
  },
  "commandAliases": [
    { "name": "adminme-now", "kind": "runtime-slash" },
    { "name": "adminme-triage", "kind": "runtime-slash" },
    { "name": "adminme-inbox", "kind": "runtime-slash" },
    { "name": "adminme-done", "kind": "runtime-slash" },
    { "name": "adminme-defer", "kind": "runtime-slash" },
    { "name": "adminme-snooze", "kind": "runtime-slash" },
    { "name": "adminme-block", "kind": "runtime-slash" },
    { "name": "adminme-unblock", "kind": "runtime-slash" },
    { "name": "adminme-forward", "kind": "runtime-slash" }
  ],
  "contracts": {
    "agentToolResultMiddleware": ["openclaw", "codex"],
    "nativeAccountApps": "disabled",
    "serviceWorkspaceFiles": ["AGENTS.md", "IDENTITY.md"],
    "tools": [
