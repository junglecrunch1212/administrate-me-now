    "workspace:compile": "node scripts/compile-workspace.mjs"
  },
  "dependencies": {
    "typebox": "1.3.6"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "peerDependencies": {
    "openclaw": "2026.10.10"
  },
  "peerDependenciesMeta": {
