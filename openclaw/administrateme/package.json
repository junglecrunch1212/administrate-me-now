      "optional": true
    }
  },
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "openclaw": {
    "extensions": [
      "./src/index.ts"
    ],
    "runtimeExtensions": [
      "./dist/index.js"
    ],
    "compat": {
