{
  "name": "AdministrateMe Executor v4",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-22.04",
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {"version": "latest"},
    "ghcr.io/devcontainers/features/python:1": {"version": "3.11", "installTools": true},
    "ghcr.io/devcontainers/features/node:1": {"version": "22"},
    "ghcr.io/devcontainers/features/git-lfs:1": {},
    "ghcr.io/anthropics/devcontainer-features/claude-code:latest": {}
  },
  "hostRequirements": {"cpus": 2, "memory": "8gb", "storage": "32gb"},
  "secrets": {
    "CLAUDE_CODE_OAUTH_TOKEN": {"description": "Claude Code OAuth token from claude setup-token. Codespaces user secret."},
    "GITHUB_TOKEN": {"description": "Auto-injected by Codespaces."},
    "ADMINME_DAILY_SPEND_CAP_USD": {"description": "Optional spend cap."}
  },
  "mounts": ["source=claude-code-config-${devcontainerId},target=/home/codespace/.claude,type=volume"],
  "containerEnv": {
    "CLAUDE_CONFIG_DIR": "/home/codespace/.claude",
    "ADMINME_BUILD_PHASE": "A",
    "ADMINME_OBSERVATION_MODE": "0",
    "ADMINME_DAILY_SPEND_CAP_USD_DEFAULT": "50",
    "ADMINME_MODEL_EXECUTOR": "opus",
    "ADMINME_MODEL_REVIEWER": "opus"
  },
  "remoteUser": "codespace",
  "containerUser": "codespace",
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "customizations": {
    "vscode": {
      "extensions": ["anthropic.claude-code", "github.vscode-pull-request-github", "ms-python.python", "ms-python.black-formatter"],
      "settings": {"terminal.integrated.defaultProfile.linux": "bash", "editor.formatOnSave": false, "files.trimTrailingWhitespace": true}
    },
    "codespaces": {"openFiles": ["README.md", "docs/build_log.md", "docs/partner_handoff.md"]}
  },
  "forwardPorts": [],
  "shutdownAction": "stopContainer"
}
