{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://administrate-me/schemas/qa_report.json",
  "title": "QA report (console layer, 14e checkpoint only)",
  "description": "QA agent's quality report focused on the Node console layer. Only fires at checkpoint 14e.",
  "type": "object",
  "required": ["checkpoint", "audit_date", "console_patterns_coverage", "findings"],
  "properties": {
    "checkpoint": {"type": "string", "const": "14e"},
    "audit_date": {"type": "string", "format": "date"},

    "console_patterns_coverage": {
      "type": "object",
      "description": "Status of each of the 12 console patterns from ADMINISTRATEME_CONSOLE_PATTERNS.md",
      "additionalProperties": {
        "type": "object",
        "required": ["status", "evidence"],
        "properties": {
          "status": {"type": "string", "enum": ["implemented", "partial", "missing", "deferred"]},
          "evidence": {"type": "string", "description": "File paths or test files demonstrating implementation"},
          "notes": {"type": ["string", "null"]}
        }
      }
    },

    "nav_surface_coverage": {
      "type": "object",
      "description": "Status of each of the 8 nav surfaces (today / triage / crm / capture / finance / calendar / scoreboard / settings)",
      "additionalProperties": {
        "type": "object",
        "required": ["primary_implemented", "tests_present"],
        "properties": {
          "primary_implemented": {"type": "boolean"},
          "tests_present": {"type": "boolean"},
          "child_role_correct": {"type": ["boolean", "null"], "description": "For nav surfaces: is HIDDEN_FOR_CHILD enforced correctly (today/scoreboard visible, rest hidden)?"}
        }
      }
    },

    "view_mode_implementation": {
      "type": "object",
      "description": "The three view modes referenced by profile packs",
      "required": ["carousel", "compressed", "child"],
      "properties": {
        "carousel": {"type": "object", "properties": {"contract_defined": {"type": "boolean"}, "reference_implementation_present": {"type": "boolean"}}},
        "compressed": {"type": "object", "properties": {"contract_defined": {"type": "boolean"}, "reference_implementation_present": {"type": "boolean"}}},
        "child": {"type": "object", "properties": {"contract_defined": {"type": "boolean"}, "reference_implementation_present": {"type": "boolean"}}}
      }
    },

    "bus_class_implementation": {
      "type": "object",
      "description": "Per D2: two classes (UpstreamBusSubscriber + ClientFanOut), not one Bus god-object",
      "required": ["compliant"],
      "properties": {
        "compliant": {"type": "boolean"},
        "evidence": {"type": "string"}
      }
    },

    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "severity", "category", "title", "description", "file_path", "recommended_fix"],
        "properties": {
          "id": {"type": "string"},
          "severity": {"type": "string", "enum": ["critical", "high", "medium", "low"]},
          "category": {
            "type": "string",
            "enum": [
              "missing_pattern",
              "incorrect_pattern_implementation",
              "missing_view",
              "missing_test",
              "child_role_violation",
              "auth_member_view_member_split_violation",
              "guarded_write_missing",
              "observation_mode_bypass",
              "other"
            ]
          },
          "title": {"type": "string"},
          "description": {"type": "string"},
          "file_path": {"type": "string"},
          "line_range": {"type": ["string", "null"]},
          "constitutional_source": {"type": "string"},
          "recommended_fix": {"type": "string", "enum": ["sidecar", "amendment", "refactor-next", "accept_as_low"]},
          "fix_summary": {"type": ["string", "null"]}
        }
      }
    },

    "operator_recommendation": {
      "type": "string",
      "enum": ["approve_continue", "approve_with_sidecars", "approve_with_amendment", "halt"]
    }
  }
}
