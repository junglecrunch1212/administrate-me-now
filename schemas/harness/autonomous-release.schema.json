{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://administrateme.local/schemas/harness/autonomous-release-v1.json",
  "title": "AdministrateMe G-002 autonomous release decision input",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "lane", "candidate", "github", "harness", "impacts", "proof", "baseline", "target_degradations", "target_doctor_checks"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "lane": {"type": "string", "enum": ["observation", "bounded_repair"]},
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base_sha", "head_sha", "changed_paths"],
      "properties": {
        "base_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "head_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "changed_paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "github": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "pull_request"],
      "properties": {
        "repository": {"type": "string", "pattern": "^[^/]+/[^/]+$"},
        "pull_request": {"type": "integer", "minimum": 1}
      }
    },
    "harness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_directory", "run_id", "binding_diff_sha256", "hosted_review_result", "hosted_review_receipt"],
      "properties": {
        "run_directory": {"type": "string", "minLength": 1},
        "run_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{7,79}$"},
        "binding_diff_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "hosted_review_result": {"type": "string", "minLength": 1},
        "hosted_review_receipt": {"type": "string", "minLength": 1}
      }
    },
    "impacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider_writes_enabled",
        "runtime_or_dependency_migration",
        "provider_enrollment",
        "credentials_keychain_or_permissions",
        "privacy_or_authorization_change",
        "destructive_data_change",
        "observation_mode_change",
        "release_control_change",
        "member_visible_behavior"
      ],
      "properties": {
        "provider_writes_enabled": {"type": "boolean"},
        "runtime_or_dependency_migration": {"type": "boolean"},
        "provider_enrollment": {"type": "boolean"},
        "credentials_keychain_or_permissions": {"type": "boolean"},
        "privacy_or_authorization_change": {"type": "boolean"},
        "destructive_data_change": {"type": "boolean"},
        "observation_mode_change": {"type": "boolean"},
        "release_control_change": {"type": "boolean"},
        "member_visible_behavior": {"type": "boolean"}
      }
    },
    "proof": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exact_head_review",
        "deterministic",
        "production_journey",
        "browser",
        "breadth",
        "release_candidate",
        "hosted_consistency",
        "hosted_macos",
        "base_contained",
        "clean_mergeable",
        "actionable_threads",
        "review_completed_at",
        "breadth_started_at",
        "attested_updater",
        "backup_capable"
      ],
      "properties": {
        "exact_head_review": {"type": "string", "const": "APPROVE"},
        "deterministic": {"type": "string", "const": "PASS"},
        "production_journey": {"type": "string", "const": "PASS"},
        "browser": {"type": "string", "enum": ["PASS", "NOT_APPLICABLE"]},
        "breadth": {"type": "string", "const": "PASS"},
        "release_candidate": {"type": "string", "const": "PASS"},
        "hosted_consistency": {"type": "string", "const": "PASS"},
        "hosted_macos": {"type": "string", "enum": ["PASS", "NOT_APPLICABLE"]},
        "base_contained": {"type": "boolean", "const": true},
        "clean_mergeable": {"type": "boolean", "const": true},
        "actionable_threads": {"type": "integer", "const": 0},
        "review_completed_at": {"type": "string", "format": "date-time"},
        "breadth_started_at": {"type": "string", "format": "date-time"},
        "attested_updater": {"type": "boolean", "const": true},
        "backup_capable": {"type": "boolean", "const": true}
      }
    },
    "baseline": {"$ref": "#/$defs/health"},
    "target_degradations": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "target_doctor_checks": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "settlement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "active_head",
        "merge_commit",
        "observation_active",
        "required_unhealthy",
        "failed_doctor_checks",
        "doctor_available",
        "privacy_isolation",
        "browser",
        "backup_verified",
        "rollback_ready",
        "provider_effects_delta"
      ],
      "properties": {
        "active_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "merge_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "observation_active": {"type": "boolean"},
        "required_unhealthy": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "failed_doctor_checks": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "doctor_available": {"type": "boolean"},
        "privacy_isolation": {"type": "string", "enum": ["PASS", "FAIL", "UNDETERMINED"]},
        "browser": {"type": "string", "enum": ["PASS", "FAIL", "UNDETERMINED", "NOT_APPLICABLE"]},
        "backup_verified": {"type": "boolean"},
        "rollback_ready": {"type": "boolean"},
        "provider_effects_delta": {"type": "integer", "minimum": 0}
      }
    }
  },
  "$defs": {
    "health": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime", "observation_active", "required_unhealthy", "failed_doctor_checks", "doctor_available", "provider_claims"],
      "properties": {
        "runtime": {"type": "string", "enum": ["healthy", "degraded"]},
        "observation_active": {"type": "boolean"},
        "required_unhealthy": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "failed_doctor_checks": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "doctor_available": {"type": "boolean"},
        "provider_claims": {"type": "integer", "minimum": 0}
      }
    }
  }
}
