{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://administrateme.local/schemas/harness/preservation-manifest-v1.json",
  "title": "AdministrateMe preservation manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "binding", "classification", "touched_surfaces", "preserved_behaviors", "no_change_boundaries", "state_boundaries", "characterization_checks", "migration_required", "rollback"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "run_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{7,79}$"},
    "binding": {"$ref": "#/$defs/binding"},
    "classification": {"type": "string", "enum": ["PRESERVE", "MODERNIZE", "SUPERSEDE", "DEFER"]},
    "touched_surfaces": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "preserved_behaviors": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/behavior"}},
    "no_change_boundaries": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "state_boundaries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["state", "expected_behavior", "evidence"],
        "properties": {
          "state": {"type": "string", "enum": ["happy", "empty", "loading", "stale", "degraded", "denied", "retry", "terminal_failure"]},
          "expected_behavior": {"type": "string", "minLength": 1},
          "evidence": {"type": "string", "minLength": 1}
        }
      }
    },
    "characterization_checks": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "migration_required": {"type": "boolean"},
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_owned_paths", "method", "forbidden_operations"],
      "properties": {
        "task_owned_paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "method": {"type": "string", "minLength": 1},
        "forbidden_operations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    }
  },
  "$defs": {
    "behavior": {
      "type": "object",
      "additionalProperties": false,
      "required": ["behavior_id", "when", "then", "evidence"],
      "properties": {
        "behavior_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
        "when": {"type": "string", "minLength": 1},
        "then": {"type": "string", "minLength": 1},
        "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base_sha", "head_sha", "diff_sha256", "branch", "evidence_class"],
      "properties": {
        "base_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "head_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "diff_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "branch": {"type": "string", "minLength": 1},
        "evidence_class": {"type": "string", "enum": ["fixture", "local_candidate", "hosted_ci", "live"]}
      }
    }
  }
}
