{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://administrateme.local/schemas/harness/g002-observation-release-policy-v1.json",
  "title": "AdministrateMe G-002 healthy observation release activation policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "pull_request",
    "merge_commit",
    "merge_base_parent",
    "reviewed_head",
    "admission_manifest_sha256",
    "observation_mode_required",
    "provider_claims_required",
    "baseline_required_unhealthy",
    "baseline_failed_doctor_checks"
  ],
  "properties": {
    "contract": {"type": "string", "const": "g002-observation-release-activation-v1"},
    "pull_request": {"type": "integer", "minimum": 1},
    "merge_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "merge_base_parent": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "reviewed_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "admission_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "observation_mode_required": {"type": "boolean", "const": true},
    "provider_claims_required": {"type": "integer", "const": 0},
    "baseline_required_unhealthy": {"type": "array", "maxItems": 0},
    "baseline_failed_doctor_checks": {"type": "array", "maxItems": 0}
  }
}
