{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://administrateme.local/schemas/harness/g002-release-queue-v1.json",
  "title": "AdministrateMe G-002 local release queue entry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "repository",
    "pull_request",
    "base_sha",
    "head_sha",
    "changed_paths",
    "run_directory",
    "run_id",
    "binding_diff_sha256",
    "lane",
    "target_degradations",
    "target_doctor_checks",
    "impacts",
    "queued_at"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "status": {"type": "string", "const": "QUEUED"},
    "repository": {"type": "string", "pattern": "^[^/]+/[^/]+$"},
    "pull_request": {"type": "integer", "minimum": 1},
    "base_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "head_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "changed_paths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "run_directory": {"type": "string", "pattern": "^/"},
    "run_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{7,79}$"},
    "binding_diff_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "lane": {"type": "string", "enum": ["observation", "bounded_repair"]},
    "target_degradations": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "target_doctor_checks": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "impacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider_writes_enabled",
        "runtime_or_dependency_migration",
        "provider_enrollment",
        "credentials_keychain_or_permissions",
        "privacy_or_authorization_change",
        "destructive_data_change",
        "observation_mode_change",
        "release_control_change",
        "member_visible_behavior"
      ],
      "properties": {
        "provider_writes_enabled": {"type": "boolean"},
        "runtime_or_dependency_migration": {"type": "boolean"},
        "provider_enrollment": {"type": "boolean"},
        "credentials_keychain_or_permissions": {"type": "boolean"},
        "privacy_or_authorization_change": {"type": "boolean"},
        "destructive_data_change": {"type": "boolean"},
        "observation_mode_change": {"type": "boolean"},
        "release_control_change": {"type": "boolean"},
        "member_visible_behavior": {"type": "boolean"}
      }
    },
    "queued_at": {"type": "string", "format": "date-time"}
  }
}
