{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://administrateme.local/schemas/harness/owner-handoff-v1.json",
  "title": "AdministrateMe owner handoff metadata",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "binding", "requested_outcome", "what_now_works", "what_did_not_change", "proof", "try_this", "remaining_decision", "release_status"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "run_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{7,79}$"},
    "binding": {"$ref": "#/$defs/binding"},
    "requested_outcome": {"type": "string", "minLength": 1},
    "what_now_works": {"type": "string", "minLength": 1},
    "what_did_not_change": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "proof": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deterministic", "production_journey", "browser", "independent_review"],
      "properties": {
        "deterministic": {"type": "string", "enum": ["PASS", "FAIL", "UNDETERMINED"]},
        "production_journey": {"type": "string", "enum": ["PASS", "FAIL", "UNDETERMINED"]},
        "browser": {"type": "string", "enum": ["PASS", "FAIL", "UNDETERMINED", "NOT_APPLICABLE"]},
        "independent_review": {"type": "string", "enum": ["APPROVE", "CHANGES_REQUIRED", "UNDETERMINED"]}
      }
    },
    "try_this": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_path", "task", "expected_result", "desktop_screenshot", "narrow_screenshot"],
      "properties": {
        "start_path": {"type": "string", "pattern": "^/"},
        "task": {"type": "string", "minLength": 1},
        "expected_result": {"type": "string", "minLength": 1},
        "desktop_screenshot": {"type": ["string", "null"]},
        "narrow_screenshot": {"type": ["string", "null"]}
      }
    },
    "remaining_decision": {"type": ["string", "null"]},
    "release_status": {"type": "string", "enum": ["NOT_RELEASED", "CANDIDATE_ONLY", "RELEASED"]}
  },
  "$defs": {
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base_sha", "head_sha", "diff_sha256", "branch", "evidence_class"],
      "properties": {
        "base_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "head_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "diff_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "branch": {"type": "string", "minLength": 1},
        "evidence_class": {"type": "string", "enum": ["fixture", "local_candidate", "hosted_ci", "live"]}
      }
    }
  }
}
