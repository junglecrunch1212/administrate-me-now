{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://administrateme.local/schemas/harness/evidence-inventory-v1.json",
  "title": "AdministrateMe evidence inventory",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "binding", "instructions", "governing_sources", "repository_state", "inventories", "evidence"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "run_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{7,79}$"},
    "binding": {"$ref": "#/$defs/binding"},
    "instructions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "governing_sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "status", "evidence_class"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "status": {"type": "string", "enum": ["accepted", "released", "candidate", "provenance", "UNDETERMINED"]},
          "evidence_class": {"type": "string", "enum": ["fixture", "local_candidate", "hosted_ci", "live"]}
        }
      }
    },
    "repository_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tracked_changes", "untracked_paths", "protected_paths", "protected_path_bindings"],
      "properties": {
        "tracked_changes": {"type": "array", "items": {"type": "string"}},
        "untracked_paths": {"type": "array", "items": {"type": "string"}},
        "protected_paths": {"type": "array", "items": {"type": "string"}},
        "protected_path_bindings": {
          "type": "array",
          "items": {"$ref": "#/$defs/protected_path_binding"}
        }
      }
    },
    "inventories": {
      "type": "object",
      "additionalProperties": false,
      "required": ["surfaces", "projections", "adapter_categories", "pack_kinds", "profiles", "personas"],
      "properties": {
        "surfaces": {"$ref": "#/$defs/string_list"},
        "projections": {"$ref": "#/$defs/string_list"},
        "adapter_categories": {"$ref": "#/$defs/string_list"},
        "pack_kinds": {"$ref": "#/$defs/string_list"},
        "profiles": {"$ref": "#/$defs/string_list"},
        "personas": {"$ref": "#/$defs/string_list"}
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim", "source", "evidence_class"],
        "properties": {
          "claim": {"type": "string", "minLength": 1},
          "source": {"type": "string", "minLength": 1},
          "evidence_class": {"type": "string", "enum": ["fixture", "local_candidate", "hosted_ci", "live"]}
        }
      }
    }
  },
  "$defs": {
    "string_list": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "protected_path_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "exists", "file_type", "mode", "content_sha256", "symlink_target_sha256", "entry_count"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "exists": {"type": "boolean"},
        "file_type": {"type": "string", "enum": ["absent", "regular", "directory", "symlink", "other"]},
        "mode": {"anyOf": [{"type": "string", "pattern": "^[0-7]{4}$"}, {"type": "null"}]},
        "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "symlink_target_sha256": {"anyOf": [{"type": "string", "pattern": "^[0-9a-f]{64}$"}, {"type": "null"}]},
        "entry_count": {"type": "integer", "minimum": 0}
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base_sha", "head_sha", "diff_sha256", "branch", "evidence_class"],
      "properties": {
        "base_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "head_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "diff_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "branch": {"type": "string", "minLength": 1},
        "evidence_class": {"type": "string", "enum": ["fixture", "local_candidate", "hosted_ci", "live"]}
      }
    }
  }
}
