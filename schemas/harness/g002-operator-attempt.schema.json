{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://administrateme.local/schemas/harness/g002-operator-attempt-v1.json",
  "title": "AdministrateMe G-002 scheduled operator attempt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "queue_sha256",
    "repository",
    "pull_request",
    "base_sha",
    "head_sha",
    "run_id",
    "binding_diff_sha256",
    "decision",
    "queue_closed",
    "merge_commit",
    "deployed_sha",
    "settlement_manifest_path",
    "settlement_manifest_sha256",
    "rollback_result",
    "remaining_degradations",
    "remaining_doctor_checks",
    "reason_codes",
    "elapsed_seconds",
    "recorded_at"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "queue_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "repository": {"type": "string", "pattern": "^[^/]+/[^/]+$"},
    "pull_request": {"type": "integer", "minimum": 1},
    "base_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "head_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "run_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{7,79}$"},
    "binding_diff_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "decision": {
      "type": "string",
      "enum": [
        "WAITING_REVIEW",
        "WAITING_CHECKS",
        "SUPERSEDED",
        "G001_REQUIRED",
        "ADMISSION_DENIED",
        "COMPLETE",
        "ROLLED_BACK",
        "DEPLOYMENT_INCOMPLETE",
        "REPAIR_LIMIT_REACHED"
      ]
    },
    "queue_closed": {"type": "boolean"},
    "merge_commit": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{40}$"
    },
    "deployed_sha": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{40}$"
    },
    "settlement_manifest_path": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "settlement_manifest_sha256": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    },
    "rollback_result": {
      "type": "string",
      "enum": ["NOT_APPLICABLE", "PASS", "FAIL", "UNDETERMINED"]
    },
    "remaining_degradations": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"}
    },
    "remaining_doctor_checks": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"}
    },
    "reason_codes": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9._:-]{0,127}$"}
    },
    "elapsed_seconds": {"type": "number", "minimum": 0},
    "recorded_at": {"type": "string", "format": "date-time"}
  }
}
