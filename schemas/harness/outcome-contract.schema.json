{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://administrateme.local/schemas/harness/outcome-contract-v1.json",
  "title": "AdministrateMe outcome contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "binding",
    "requested_outcome",
    "primary_journey",
    "visible_non_goals",
    "acceptance_cases",
    "privacy",
    "release_impacts",
    "external_or_irreversible",
    "owner_questions"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "run_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{7,79}$"},
    "binding": {"$ref": "#/$defs/binding"},
    "requested_outcome": {"type": "string", "minLength": 1},
    "primary_journey": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actor_role", "start_path", "steps", "expected_result"],
      "properties": {
        "actor_role": {"type": "string", "enum": ["principal", "child", "device", "ambient"]},
        "start_path": {"type": "string", "pattern": "^/"},
        "steps": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "expected_result": {"type": "string", "minLength": 1}
      }
    },
    "visible_non_goals": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "acceptance_cases": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case_id", "state", "applicable", "when", "then"],
        "properties": {
          "case_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
          "state": {"type": "string", "enum": ["happy", "empty", "loading", "stale", "degraded", "denied", "retry", "terminal_failure"]},
          "applicable": {"type": "boolean"},
          "when": {"type": "string", "minLength": 1},
          "then": {"type": "string", "minLength": 1},
          "not_applicable_reason": {"type": "string", "minLength": 1}
        },
        "allOf": [
          {
            "if": {"properties": {"applicable": {"type": "boolean", "const": false}}},
            "then": {"required": ["not_applicable_reason"]}
          }
        ]
      },
      "allOf": [
        {"contains": {"properties": {"state": {"const": "happy"}}, "required": ["state"]}},
        {"contains": {"properties": {"state": {"const": "empty"}}, "required": ["state"]}},
        {"contains": {"properties": {"state": {"const": "loading"}}, "required": ["state"]}},
        {"contains": {"properties": {"state": {"const": "stale"}}, "required": ["state"]}},
        {"contains": {"properties": {"state": {"const": "degraded"}}, "required": ["state"]}},
        {"contains": {"properties": {"state": {"const": "denied"}}, "required": ["state"]}},
        {"contains": {"properties": {"state": {"const": "retry"}}, "required": ["state"]}},
        {"contains": {"properties": {"state": {"const": "terminal_failure"}}, "required": ["state"]}}
      ]
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["touches_private_data", "changes_authorization", "notes"],
      "properties": {
        "touches_private_data": {"type": "boolean"},
        "changes_authorization": {"type": "boolean"},
        "notes": {"type": "string"}
      }
    },
    "release_impacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider_writes_enabled",
        "runtime_or_dependency_migration",
        "provider_enrollment",
        "credentials_keychain_or_permissions",
        "privacy_or_authorization_change",
        "destructive_data_change",
        "observation_mode_change",
        "release_control_change",
        "member_visible_behavior"
      ],
      "properties": {
        "provider_writes_enabled": {"$ref": "#/$defs/release_impact"},
        "runtime_or_dependency_migration": {"$ref": "#/$defs/release_impact"},
        "provider_enrollment": {"$ref": "#/$defs/release_impact"},
        "credentials_keychain_or_permissions": {"$ref": "#/$defs/release_impact"},
        "privacy_or_authorization_change": {"$ref": "#/$defs/release_impact"},
        "destructive_data_change": {"$ref": "#/$defs/release_impact"},
        "observation_mode_change": {"$ref": "#/$defs/release_impact"},
        "release_control_change": {"$ref": "#/$defs/release_impact"},
        "member_visible_behavior": {"$ref": "#/$defs/release_impact"}
      }
    },
    "external_or_irreversible": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "side_effect_class", "notes"],
      "properties": {
        "required": {"type": "boolean"},
        "side_effect_class": {"type": "string", "enum": ["READ", "LOCAL_WRITE", "REPOSITORY_WRITE", "EXTERNAL_WRITE", "RELEASE", "LIVE_HOUSEHOLD"]},
        "notes": {"type": "string"}
      }
    },
    "owner_questions": {"type": "array", "maxItems": 1, "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "release_impact": {
      "type": "string",
      "enum": ["YES", "NO", "UNDETERMINED"]
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base_sha", "head_sha", "diff_sha256", "branch", "evidence_class"],
      "properties": {
        "base_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "head_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "diff_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "branch": {"type": "string", "minLength": 1},
        "evidence_class": {"type": "string", "enum": ["fixture", "local_candidate", "hosted_ci", "live"]}
      }
    }
  }
}
