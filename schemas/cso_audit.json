{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://administrate-me/schemas/cso_audit.json",
  "title": "CSO security audit",
  "description": "CSO agent's security audit output at a checkpoint. Confidence-rated findings with concrete file/line citations.",
  "type": "object",
  "required": ["checkpoint", "audit_date", "total_findings_by_severity", "findings"],
  "properties": {
    "checkpoint": {"type": "string", "enum": ["10d", "14e", "15.5", "07.5"]},
    "audit_date": {"type": "string", "format": "date"},
    "total_findings_by_severity": {
      "type": "object",
      "required": ["critical", "high", "medium", "low"],
      "properties": {
        "critical": {"type": "integer"},
        "high": {"type": "integer"},
        "medium": {"type": "integer"},
        "low": {"type": "integer"}
      }
    },
    "sweep_summary": {
      "type": ["object", "null"],
      "description": "Used only by 15.5 — verdict per SYSTEM_INVARIANTS section.",
      "additionalProperties": {
        "type": "string",
        "enum": ["pass", "drift", "violation"]
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "severity", "confidence", "title", "description", "file_path", "line_range", "constitutional_source", "recommended_fix", "exploit_scenario"],
        "properties": {
          "id": {"type": "string", "description": "Stable id within this audit, e.g. 'CSO-10d-001'"},
          "severity": {"type": "string", "enum": ["critical", "high", "medium", "low"]},
          "confidence": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10,
            "description": "0-10 confidence this is a real issue (per gstack CSO pattern)"
          },
          "title": {"type": "string", "description": "One-line summary"},
          "description": {"type": "string", "description": "Full description, plain English"},
          "file_path": {"type": "string"},
          "line_range": {"type": "string", "description": "e.g. '142-156'"},
          "constitutional_source": {"type": "string", "description": "e.g. '[§6.14]' or '[§8.2, D6]'"},
          "exploit_scenario": {"type": "string", "description": "Concrete attack/failure scenario if this is exploited or left uncorrected"},
          "recommended_fix": {"type": "string", "enum": ["sidecar", "amendment", "refactor-next", "accept_as_low"]},
          "fix_summary": {"type": ["string", "null"], "description": "One-line summary of the fix"}
        }
      }
    },
    "phase_b_registration_queue_status": {
      "type": ["object", "null"],
      "description": "Used only by 15.5 — status of bootstrap/openclaw/ artifacts.",
      "properties": {
        "programs_present": {"type": "boolean"},
        "cron_yaml_present": {"type": "boolean"},
        "skill_packs_ready": {"type": "boolean"},
        "missing_items": {"type": "array", "items": {"type": "string"}}
      }
    },
    "operator_recommendation": {
      "type": "string",
      "enum": ["approve_continue", "approve_with_sidecars", "approve_with_amendment", "halt"]
    }
  }
}
